# The image build copies go.mod, go.sum, catalog/, chartcache/, cmd/,
# deploy/, gitops/, internal/ and treeedit/ (Dockerfile): what is left out here neither builds the binary
# nor, by changing, throws the build cache away.
.git
.github
.idea/
.claude/
bin/
docs/
tools/
testdata/
**/testdata/
**/*_test.go
*.test
*.out
# A binary built in place (go build ./cmd/okdp-gitops).
cmd/okdp-gitops/okdp-gitops
